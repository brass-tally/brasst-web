{
  "name": "brasstally-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "node ../scripts/check-tdz.mjs src/App.jsx && node ../scripts/check-css.mjs && node ../scripts/check-handlers.mjs src/App.jsx && node ../scripts/check-inline-components.mjs src/App.jsx && node ../scripts/check-write-lock.mjs && node ../scripts/check-props.mjs && npm run lint",
    "test": "node ../scripts/tests-tax.mjs && node ../scripts/tests-rules.mjs",
    "legal": "node ../scripts/build-legal.mjs",
    "lint": "eslint src --max-warnings 9999"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.4.0"
  }
}